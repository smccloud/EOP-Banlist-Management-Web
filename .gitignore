# Written by the setup wizard at install time. config.php is regenerated by
# setup.php (ensureConfigPhp) and then rewritten with the entered values, so it
# carries deployment-specific data rather than source. Every entry point already
# handles its absence: index.php, login.php and actions.php redirect to setup.php,
# and cron-sync.php exits with a message naming the URL.
config.php
installed.lock
